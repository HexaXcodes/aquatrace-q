# Copy to .env and adjust for your machine. Never commit the real .env.

# --- Application -------------------------------------------------------
APP_NAME=AquaTrace-Q Backend
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# Local docker-compose default matches this out of the box.
DATABASE_URL=postgresql+psycopg2://aquatrace:aquatrace@localhost:5432/aquatrace
DATABASE_ECHO=false

# --- Async task queue (unused until a later phase genuinely needs it) ------
REDIS_URL=

# --- Storage -------------------------------------------------------------
DATA_DIRECTORY=data
UPLOAD_DIRECTORY=uploads
OUTPUT_DIRECTORY=outputs
MODEL_DIRECTORY=models

# --- Upload constraints -----------------------------------------------------
MAX_UPLOAD_SIZE=209715200
ALLOWED_SONAR_EXTENSIONS=png,jpg,jpeg,tif,tiff

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- GIS (Phases 12-13) --------------------------------------------------------
REEF_DATA_PATH=
MPA_DATA_PATH=
GIS_ENABLED=false

# --- ML / QML (Phases 5-10) ----------------------------------------------------
ML_MODEL_VERSION=
QML_ENABLED=true
QML_FEATURE_DIMENSIONS=4

# --- Uncertainty (Phase 10) -----------------------------------------------------
UNCERTAINTY_HIGH_THRESHOLD=0.66
UNCERTAINTY_MEDIUM_THRESHOLD=0.33

# --- Risk engine (Phase 14) -- weights should sum to 100 ------------------------
RISK_WEIGHT_DEBRIS_TYPE=30.0
RISK_WEIGHT_REEF_PROXIMITY=30.0
RISK_WEIGHT_PROTECTED_AREA=15.0
RISK_WEIGHT_SIZE=15.0
RISK_WEIGHT_CONFIDENCE=10.0
RISK_WEIGHTS_VERSION=v1
RISK_LEVEL_CRITICAL_THRESHOLD=85.0
RISK_LEVEL_HIGH_THRESHOLD=60.0
RISK_LEVEL_MEDIUM_THRESHOLD=30.0

# --- Priority engine (Phase 15) --------------------------------------------------
PRIORITY_VERIFY_NOW_RISK_THRESHOLD=75.0
PRIORITY_VERIFY_NEXT_RISK_THRESHOLD=45.0
PRIORITY_IGNORE_CONFIDENCE_THRESHOLD=0.85

# --- Mission planning (Phase 16) --------------------------------------------------
MISSION_DEFAULT_VEHICLE_SPEED_MPS=1.0
